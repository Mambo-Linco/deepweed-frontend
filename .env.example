# Only needed when the web app and the backend are on DIFFERENT addresses (hosting).
# Local development does not need this (Vite proxies /api to the backend).
# FAKE example - use your backend's real address:
VITE_API_URL=https://deepweed-backend.onrender.com

# Local development only: where the dev proxy forwards /api
VITE_BACKEND_URL=https://deepweed-backend.onrender.com
